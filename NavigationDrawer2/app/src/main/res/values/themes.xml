<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.NavigationDrawer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple</item>
        <item name="colorPrimaryVariant">@color/purpleLight</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/teal</item>
        <item name="colorSecondaryVariant">@color/tealMid</item>
        <item name="colorOnSecondary">@color/tealDark</item>

        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

    </style>

    <style name="Theme.NavigationDrawer" parent="Base.Theme.NavigationDrawer">
    </style>

    <style name="Theme.NavigationDrawer.MyThemeNoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>